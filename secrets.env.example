# Your email - Required by some API's to allow programatic downloads (Unpaywall).
USER_EMAIL=

# For storing API keys and access tokens for specific publishers.
WILEY_TDM_TOKEN=
SPRINGER_API_KEY=
ELSEVIER_API_KEY=

# MinerU remote VLM (optional, advanced). When set, transform_text() sends VLM inference to this
# OpenAI-compatible server (e.g. vLLM serving opendatalab/MinerU2.5-Pro-2605-1.2B) instead of running
# it locally. Leave blank to run locally. The API key is only needed if the server requires one.
MINERU_VLM_SERVER_URL=
MINERU_VLM_API_KEY=