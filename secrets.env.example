# Copy this file to secrets.env and fill in your values. secrets.env is gitignored.

# User settings.
USER_EMAIL=you@example.com

# Client API keys.
WILEY_TDM_TOKEN=
SPRINGER_API_KEY=
ELSEVIER_API_KEY=

# LLM fallback settings (optional). Defaults to a local Ollama server running llama3.2:3b.
# Any OpenAI-compatible endpoint/model can be substituted.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=llama3.2:3b

# MinerU tuning (optional, advanced). Integer GB of GPU VRAM MinerU may budget for;
# overrides auto-detection to raise inference batch sizes. Leave blank to auto-detect.
MINERU_VIRTUAL_VRAM_SIZE=

# MinerU remote inference (optional). Required when transform_text(mineru_endpoint="vllm"):
# a vLLM server hosting the MinerU VLM model (e.g. http://host:30000), plus the API key
# the server was started with. Leave blank to run MinerU locally.
MINERU_VLLM_ENDPOINT=
MINERU_API_KEY=